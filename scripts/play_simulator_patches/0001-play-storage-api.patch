              : UINT64_MAX; // Fail closed if the preceding total query succeeded.
 }
 
+#if defined(CROSSINK_PLAY)
+bool HalStorage::freeBytes(uint64_t &out) {
+  struct statvfs stats{};
+  if (!storageStats(stats) || stats.f_frsize == 0 || stats.f_bavail > stats.f_blocks)
+    return false;
+  out = uint64_t(stats.f_bavail) * stats.f_frsize;
+  return true;
+}
+
+bool HalStorage::openFileForAppend(const char *, const char *path, HalFile &file) {
+  // SdFat's O_AT_END seeks once; it does not force every later write to append.
+  file = open(path, O_RDWR | O_CREAT);
+  if (!file.isOpen())
+    return false;
+  if (!file.seek(file.size())) {
+    file.close();
+    return false;
+  }
+  return true;
+}
+bool HalStorage::openFileForAppend(const char *moduleName, const std::string &path, HalFile &file) {
+  return openFileForAppend(moduleName, path.c_str(), file);
+}
+bool HalStorage::openFileForAppend(const char *moduleName, const String &path, HalFile &file) {
+  return openFileForAppend(moduleName, path.c_str(), file);
+}
+#endif
