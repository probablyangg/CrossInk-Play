+#if defined(CROSSINK_PLAY)
+bool SDCardManager::sdFreeBytes(uint64_t& out) {
+  if (!initialized) return false;
+  const int32_t freeClusters = vol().freeClusterCount();
+  const uint64_t clusterCount = vol().clusterCount();
+  const uint32_t clusterBytes = vol().bytesPerCluster();
+  if (freeClusters < 0 || clusterCount == 0 || clusterBytes == 0 ||
+      static_cast<uint64_t>(freeClusters) > clusterCount) {
+    return false;
+  }
+  out = static_cast<uint64_t>(freeClusters) * clusterBytes;
+  return true;
+}
+#endif
